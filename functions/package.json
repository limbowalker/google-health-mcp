{
  "name": "ghealth-mcp-functions",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "express": "^5.2.1",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "google-auth-library": "^11.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsc && node --env-file-if-exists=.env.local --env-file-if-exists=.secret.local lib/local.js",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,hosting",
    "deploy": "firebase deploy --only functions,hosting,firestore"
  }
}
