# Non-secret parameters. Copy to .env.<your-project-id> for deploys, or to .env.local for
# `npm run dev` and the Firebase emulators.
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# "auto" = https://<project-id>.web.app. For local dev use http://localhost:8080
# (npm run dev) or http://localhost:5002 (Hosting emulator).
PUBLIC_BASE_URL=auto
# "*" allows any Google account that can pass your OAuth consent screen, or list accounts/domains:
# ALLOWED_EMAILS=me@gmail.com,@example.com
ALLOWED_EMAILS=*
# 1 keeps an instance warm to avoid cold starts on Claude's 10 s OAuth timeouts (billed while idle).
MIN_INSTANCES=0

# Secrets are NOT set here. In production use:
#   firebase functions:secrets:set GOOGLE_CLIENT_SECRET
#   openssl rand -base64 32 | firebase functions:secrets:set TOKEN_ENCRYPTION_KEY --data-file=-
# Locally, put them in functions/.secret.local (gitignored):
#   GOOGLE_CLIENT_SECRET=...
#   TOKEN_ENCRYPTION_KEY=<output of: openssl rand -base64 32>
